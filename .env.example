# 실제 토큰을 이 예시 파일이나 Git에 저장하지 않는다.
GENOS_URL=https://genos.genon.ai
GENOS_SERVING_ID=850
GENOS_MODEL=qwen/qwen3.7-flash
GENOS_BEARER_TOKEN=<secret>
INTENT_PROMPT_VERSION=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=0
PROJECT_CODE=acqsc

# Redis가 없는 단일 프로세스 개발 환경은 memory를 사용한다. 운영·다중 worker는
# redis로 변경해야 추천질문 후속 문맥과 전체 대화이력이 공유·유지된다.
CHAT_HISTORY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_HISTORY_KEY_PREFIX=chat:history
CHAT_HISTORY_LIMIT=10
REDIS_DEDUPE_TTL_SECONDS=86400
REDIS_HISTORY_TTL_SECONDS=3600

# Action/HITL 재개 상태. 로컬 단일 프로세스는 memory, 운영·다중 worker는
# redis를 사용한다. HITL은 완료 시 즉시 삭제되고 미완료 상태는 TTL로 만료된다.
HITL_STATE_BACKEND=memory
REDIS_HITL_KEY_PREFIX=hitl:state
REDIS_HITL_TTL_SECONDS=3600

# Databricks 하이브리드 검색 MCP
MCP_BACKEND=http
MCP_ID=<mcp-server-id>
MCP_BEARER_TOKEN=<secret>
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=0

# 개발 추적 CSV. 운영 개인정보 정책에 맞게 false로 끌 수 있다.
CSV_TRACE_ENABLED=true
CSV_TRACE_DIR=data/intent_traces

# GenOS 문서 reranking: false이면 검색 순서를 그대로 사용한다.
RERANKING_ENABLED=false
RERANKING_SERVING_ID=226
RERANKING_MODEL=bge-reranker-v2-m3
RERANKING_BEARER_TOKEN=<secret>
RERANKING_TOP_N=5
RERANKING_TIMEOUT_SECONDS=30
RERANKING_ENDPOINT_PATH=rerank

# Bastion Guardian AI 가드레일. 키가 비어 있으면 INPUT/OUTPUT 모두 네트워크
# 호출 없이 PASS한다. 운영 키는 파일에 기록하지 말고 Secret으로 주입한다.
AI_GUARDRAIL_BASE_URL=https://bastionguardian-api.startfort.io
AI_GUARDRAIL_ENDPOINT_PATH=/v1/huard/api
AI_GUARDRAIL_API_KEY=
AI_GUARDRAIL_TIMEOUT_SECONDS=15
# 키가 설정된 운영 환경에서는 false를 유지해 장애 시 원문 노출을 차단한다.
AI_GUARDRAIL_FAIL_OPEN=false

# 개발 중에는 고정 오류 답변 옆에 오류코드·내용을 표시한다.
# 운영 환경에서는 false로 설정하고 상세 원인은 서버 로그에서만 확인한다.
RESPONSE_ERROR_DETAILS_ENABLED=true
