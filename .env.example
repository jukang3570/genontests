# 실제 토큰을 이 예시 파일이나 Git에 저장하지 않는다.
GENOS_URL=https://genos.genon.ai

# Redis 대화 이력: 마지막 메시지 저장 후 1시간 동안 유지한다.
CHAT_HISTORY_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
REDIS_HISTORY_KEY_PREFIX=chat:history
CHAT_HISTORY_LIMIT=10
REDIS_DEDUPE_TTL_SECONDS=86400
REDIS_HISTORY_TTL_SECONDS=3600

# Databricks 하이브리드 검색 MCP
MCP_BACKEND=http
MCP_ID=551
MCP_BEARER_TOKEN=<secret>

# GenOS 문서 reranking: false이면 검색 순서를 그대로 사용한다.
RERANKING_ENABLED=false
RERANKING_SERVING_ID=226
RERANKING_MODEL=bge-reranker-v2-m3
RERANKING_BEARER_TOKEN=<secret>
RERANKING_TOP_N=5
RERANKING_TIMEOUT_SECONDS=30
RERANKING_ENDPOINT_PATH=rerank
